
/**
 * Purpose: Teacher lesson creation, personalized story selection,
 * and academic question review.
 *
 * Original implementation: Existing team project code.
 * AI-assisted modification: Connect the existing story workflow
 * to Torian's educator-loop question review API.
 *
 * Directed by: Edenna Chen
 * Modifications generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
 * Human edits: Added test case to reduce API calls made during development, see comments below.
 * External sources: None
 *
 * Notes:
 * - Preserves POST /api/lessons/story-concepts.
 * - Loads supported competencies from GET /api/meta.
 * - Uses POST /api/preps for academic question preparation.
 * - Supports editing, rejecting, restoring, and regenerating.
 * - Supports teacher-reviewed assembly preview.
 * - AI-assisted preview update: refresher, dialogue, help, scenes, and alignment warning.
 * - Does not yet persist or assign lessons.
 */

import { useEffect, useState } from 'react';
import type { ApiStudent } from '../../api/students';
// AI-ASSISTED ADDITION (2026-11-05): Local mission rendering, without assignment or persistence.
import LessonRenderer from '../../components/lesson/LessonRenderer';
import type { RenderableLesson, PreparedLessonSequence } from '../../components/lesson/LessonRenderer';

type StoryConcept = {
  id: string;
  title: string;
  premise: string;
  story_goal: string;
  learning_connection: string;
  visual_theme?: Record<string, unknown>;
};

type Competency = {
  id: string;
  name?: string;
  label?: string;
  description?: string;
};

type PrepQuestion = {
  id: string;
  competency: string;
  difficulty: string | number;
  original: string;
  text: string;
  missing_numbers: unknown[];
  flagged: boolean;
  note: string | null;
  status: 'ok' | 'edited' | 'rejected';
};

type Prep = {
  id: string;
  student: string;
  interest: string;
  competencies: string[];
  status: string;
  questions: PrepQuestion[];
};

// ------------------------------------------------------------
// AI-ASSISTED ADDITION: AssembledLesson
// Purpose: Type the response returned by the existing assembly API.
// Directed by: Edenna Chen
// Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
// Notes: Preview only; no persistence or student assignment.
// ------------------------------------------------------------
// ------------------------------------------------------------
// AI-ASSISTED UPDATE: Extended assembled lesson response types
// Purpose: Display new story-sequence fields without changing API calls.
// Directed by: Edenna Chen
// Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
// Notes: Optional fields keep older backend responses previewable.
// ------------------------------------------------------------
type Refresher = {
  concept?: string;
  explanation?: string;
  worked_example?: string | {
    question?: string;
    steps?: string[];
    answer?: string;
    explanation?: string;
  };
  [key: string]: unknown;
};

type PreviewQuestion = {
  question_id: string;
  text: string;
  narrative?: string;
  story_dialogue?: string;
  challenge_transition?: string;
  challenge_prompt?: string;
  instruction?: string;
  worked_example?: string;
  optional_reminder?: string;
  reminder?: string;
  walkthrough?: string[];
  // AI-assisted fix (2026-11-05): Match backend-generated help field.
  optional_walkthrough?: string[];
  visual_prompt?: string;
  before_visual_prompt?: string;
  after_visual_prompt?: string;
  success_event?: string;
  story_bridge?: string;
};

type AssembledLesson = {
  lesson_id: string;
  student_id: string;
  objective: string;
  story: StoryConcept;
  introduction: string;
  introduction_visual_prompt?: string;
  refresher?: Refresher | string;
  alignment_warning?: string | null;
  story_complexity?: string;
  activities: Array<{
    type: string;
    activity_number: number;
    questions: PreviewQuestion[];
  }>;
  conclusion: string;
  conclusion_visual_prompt?: string;
  finale_animation?: { type?: string; target?: string };
  llm_mode: string;
  // AI-assisted: accept optional mission metadata from newer assembly responses.
  mission?: unknown;
  mission_plan?: unknown;
  milestones?: unknown;
  trophy?: unknown;
  presentation?: unknown;
};

// AI-ASSISTED ADDITION (2026-11-05): Read optional mission metadata safely.
// The backend may return different mission-plan shapes; the preview falls
// back to approved question order rather than inventing narrative milestones.
function asObject(value: unknown): Record<string, unknown> | null {
  return value !== null && typeof value === 'object' && !Array.isArray(value)
    ? value as Record<string, unknown> : null;
}

function firstText(source: Record<string, unknown> | null, keys: string[]): string | null {
  if (!source) return null;
  for (const key of keys) {
    const value = source[key];
    if (typeof value === 'string' && value.trim()) return value.trim();
  }
  return null;
}

function getMissionSteps(lesson: AssembledLesson): string[] {
  const mission = asObject(lesson.mission_plan) ?? asObject(lesson.mission);
  const candidate = Array.isArray(lesson.milestones) ? lesson.milestones
    : Array.isArray(mission?.milestones) ? mission.milestones
    : Array.isArray(mission?.steps) ? mission.steps : [];
  const named = candidate.map((item: unknown) => {
    if (typeof item === 'string') return item.trim();
    return firstText(asObject(item), ['short_label', 'label', 'title', 'name', 'goal', 'description']) ?? '';
  }).filter((step: string) => Boolean(step));
  if (named.length) return named;
  return lesson.activities.flatMap(activity => activity.questions)
    .map((_, index) => `Challenge ${index + 1}`);
}

function getMissionGoal(lesson: AssembledLesson): string {
  const mission = asObject(lesson.mission_plan) ?? asObject(lesson.mission);
  return firstText(mission, ['goal', 'mission_goal', 'objective', 'title', 'summary'])
    ?? lesson.story.story_goal ?? lesson.objective;
}

type AssignmentsProps = {
  students: ApiStudent[];
  selectedStudentId: string | null;
};

const pacing = {
  target_minutes: 20,
  questions_per_chunk: 2,
  offer_breaks: true,
  break_minutes: 3,
  pacing_mode: 'student',
};

async function readJson(response: Response) {
  if (!response.ok) {
    throw new Error(
      `Request failed (${response.status}): ${await response.text()}`
    );
  }
  return response.json();
}

// ------------------------------------------------------------
// AI-ASSISTED ADDITION: getSuggestedObjective()
// Purpose: Suggest a learning objective that matches the selected
//          academic competency; teachers may edit it afterward.
// Directed by: Edenna Chen
// Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
// ------------------------------------------------------------
function getSuggestedObjective(competency: Competency): string {
  const label = competency.name || competency.label || competency.description || competency.id;
  const searchText = [competency.id, competency.name, competency.label, competency.description]
    .filter(Boolean)
    .join(' ')
    .toLowerCase();

  if (searchText.includes('integer')) {
    return 'Add and subtract positive and negative integers.';
  }
  if (searchText.includes('fraction')) {
    return 'Understand fractions as equal parts of a whole.';
  }
  return `Develop proficiency in ${label}.`;
}

// AI-ASSISTED ADDITION (2026-11-05): Adapt the teacher assembly API response
// to the standalone student-facing renderer. This does not modify the lesson,
// save progress, assign a student, or perform answer validation.
function toRenderableLesson(lesson: AssembledLesson): RenderableLesson {
  const rawMission = asObject(lesson.mission) ?? asObject(lesson.mission_plan);
  const rawMilestones = Array.isArray(lesson.milestones) ? lesson.milestones : [];
  const milestones = rawMilestones.flatMap(item => {
    const record = asObject(item);
    if (!record) return [];
    const questionId = firstText(record, ['question_id']);
    const title = firstText(record, ['title', 'task_title']);
    return questionId && title ? [{ question_id: questionId, title }] : [];
  });
  return {
    lesson_id: lesson.lesson_id,
    objective: lesson.objective,
    story: { title: lesson.story.title },
    mission: rawMission ? {
      title: firstText(rawMission, ['title']) ?? undefined,
      goal: firstText(rawMission, ['goal', 'story_goal']) ?? undefined,
    } : undefined,
    milestones,
    introduction: lesson.introduction,
    refresher: lesson.refresher,
    activities: lesson.activities.map(activity => ({
      activity_number: activity.activity_number,
      questions: activity.questions.map(question => ({
        ...question,
        // AI-assisted fix (2026-11-05):
        // Preserve help steps returned by the lesson assembly API.
        optional_walkthrough: question.optional_walkthrough ?? question.walkthrough,
      })),
    })),
    conclusion: lesson.conclusion,
    story_complexity: lesson.story_complexity,
    alignment_warning: lesson.alignment_warning,
  };
}

export default function Assignments({
  students,
  selectedStudentId,
}: AssignmentsProps) {
  const [studentId, setStudentId] = useState(
    selectedStudentId ?? students[0]?.id ?? ''
  );
  // TEACHER_STUDENT_PIPELINE_DEMO_2026: The same selected student drives profile and lesson.
  const selectedStudent = students.find(item => item.id === studentId);
  const profile = selectedStudent as unknown as Record<string, unknown> | undefined;
  const profileText = (key: string) => {
    const v = profile?.[key];
    if (Array.isArray(v)) return v.filter(x => typeof x === 'string').join(', ');
    return typeof v === 'string' ? v : '';
  };
  const [objective, setObjective] = useState('');
  const [teacherInstructions, setTeacherInstructions] = useState('');

    type StudentProfileSection = {
    ai_summary: string;
    teacher_notes: { note_text: string }[];
    };

    type StudentProfile = Record<string, StudentProfileSection>;

    const [fullStudentProfile, setFullStudentProfile] =
    useState<StudentProfile | null>(null);

    useEffect(() => {
    let active = true;
    setFullStudentProfile(null);

    if (!studentId) return;

    fetch(`/api/students/${encodeURIComponent(studentId)}/profile`)
        .then(response => {
        if (!response.ok) throw new Error('Unable to load student profile');
        return response.json();
        })
        .then((data: StudentProfile) => {
        if (active) setFullStudentProfile(data);
        })
        .catch(error => {
        console.error('Student profile loading failed:', error);
        });

    return () => {
        active = false;
    };
}, [studentId]);

  // AI-ASSISTED ADDITION (2026-11-05): Teacher-controlled narrative language level.
  // Changes generated story wording only, not academic question difficulty.
  const [storyComplexity, setStoryComplexity] = useState<'simple' | 'moderate' | 'rich'>('simple');

  const [concepts, setConcepts] = useState<StoryConcept[]>([]);
  const [selectedConceptId, setSelectedConceptId] = useState<string | null>(null);

  const [competencies, setCompetencies] = useState<Competency[]>([]);
  const [competencyId, setCompetencyId] = useState('');
  const [prep, setPrep] = useState<Prep | null>(null);
  const [drafts, setDrafts] = useState<Record<string, string>>({});

  const [loadingStories, setLoadingStories] = useState(false);
  const [loadingQuestions, setLoadingQuestions] = useState(false);
  const [busyQuestionId, setBusyQuestionId] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);

  // AI-assisted addition: Hold a teacher-only assembly preview in memory.
  const [assembledLesson, setAssembledLesson] = useState<AssembledLesson | null>(null);
  const [assembling, setAssembling] = useState(false);

  // AI-assisted addition (2026-11-05): Prepare and save sequential artwork
  // after teacher review, before playback. Design by project team.
  // Reference: React useState https://react.dev/reference/react/useState
  const [preparingAnimation, setPreparingAnimation] = useState(false);
  const [animationMessage, setAnimationMessage] = useState<string | null>(null);
  const [preparedSequence, setPreparedSequence] = useState<PreparedLessonSequence | null>(null);
  // AI-ASSISTED ADDITION: Keep assembly feedback next to its button.
  const [assemblyMessage, setAssemblyMessage] = useState<string | null>(null);

  useEffect(() => {
    if (
      selectedStudentId &&
      students.some(student => student.id === selectedStudentId)
    ) {
      setStudentId(selectedStudentId);
    } else if (!studentId && students.length > 0) {
      setStudentId(students[0].id);
    }
  }, [selectedStudentId, students, studentId]);

  useEffect(() => {
    let active = true;

    fetch('/api/meta')
      .then(readJson)
      .then(data => {
        if (!active) return;
        const available: Competency[] = data.competencies ?? [];
        setCompetencies(available);
        // AI-ASSISTED MODIFICATION: Match the initial objective to the
        // competency loaded from the academic question bank.
        const initialCompetency = available[0];
        setCompetencyId(initialCompetency?.id || '');
        setObjective(initialCompetency ? getSuggestedObjective(initialCompetency) : '');
      })
      .catch(err => {
        if (active) {
          setError(
            `Could not load academic competencies: ${String(err)}`
          );
        }
      });

    return () => {
      active = false;
    };
  }, []);

  function clearGeneratedWork() {
    setConcepts([]);
    setSelectedConceptId(null);
    setPrep(null);
    setDrafts({});
    setError(null);
    setAssembledLesson(null);
    setAssemblyMessage(null);
    setPreparedSequence(null);
    setAnimationMessage(null);
  }

  /**
 * AI-assisted addition: Temporary mock story for frontend testing.
 * Purpose: Bypass live story-generation API calls while testing
 *          the teacher's question-review workflow.
 *
 * Directed by: Edenna Chen
 * Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
 * Human edits: Pending review
 * External sources: None
 *
 * Note: This does not modify the existing live story-generation logic.
 * Remove or disable before production deployment.
 */
  function useTestStory() {
  setConcepts([
    {
      id: 'test_story',
      title: 'Minecraft Fortress',
      premise: 'Build a Minecraft fortress by completing academic challenges.',
      story_goal: 'Complete the fortress.',
      learning_connection: 'Use the selected academic competency to solve building challenges.',
    },
  ]);
  setSelectedConceptId('test_story');
  setPrep(null);
  setDrafts({});
  setError(null);
  setAssembledLesson(null);
}

  async function generateConcepts() {
    if (!studentId || !objective.trim() || !competencyId) return;

    setLoadingStories(true);
    clearGeneratedWork();

    try {
      const response = await fetch('/api/lessons/story-concepts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          student_id: studentId,
          objective: `Academic competency: ${competencyId} (${competencies.find(c => c.id === competencyId)?.name || competencies.find(c => c.id === competencyId)?.label || competencyId}). Learning objective: ${objective.trim()}`,
          question_count: 5,
          teacher_instructions: teacherInstructions,
          pacing,
        }),
      });

      const data = await readJson(response);
      const result = Array.isArray(data)
        ? data
        : data.concepts ?? data.story_concepts;

      if (!Array.isArray(result)) {
        throw new Error('Unexpected story-concept response format');
      }

      setConcepts(result);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : 'Unable to generate stories'
      );
    } finally {
      setLoadingStories(false);
    }
  }

  const selectedConcept = concepts.find(
    concept => concept.id === selectedConceptId
  );

  async function generateQuestions() {
    if (!selectedConcept || !competencyId) return;

    setLoadingQuestions(true);
    setError(null);
    setPrep(null);
    setDrafts({});
    setAssembledLesson(null);

    try {
      const student = students.find(item => item.id === studentId);

      // Read the current student's full data at click time, rather than relying
      // on a potentially empty/stale student-list entry or a pending useEffect.
      const [detailResponse, profileResponse] = await Promise.all([
        fetch(`/api/students/${encodeURIComponent(studentId)}`),
        fetch(`/api/students/${encodeURIComponent(studentId)}/profile`),
      ]);
      const studentDetail: Record<string, unknown> = await readJson(detailResponse);
      const studentProfile: StudentProfile = await readJson(profileResponse);
      const detailPreferences = (
        studentDetail.preferences && typeof studentDetail.preferences === 'object'
          ? studentDetail.preferences : studentDetail
      ) as Record<string, unknown>;
      const asText = (value: unknown): string => {
        if (typeof value === 'string') return value.trim();
        if (Array.isArray(value)) return value.filter(v => typeof v === 'string').join(', ');
        return '';
      };
      const sectionText = (section: string): string => {
        const entry = studentProfile[section];
        if (!entry) return '';
        return [
          asText(entry.ai_summary),
          ...(entry.teacher_notes ?? []).map(note => asText(note.note_text)),
        ].filter(Boolean).join('; ');
      };
      const interests = [
        asText(detailPreferences.interests_text),
        asText(detailPreferences.interests),
        sectionText('interests'),
      ].filter(Boolean).join('; ');
      // Keep the demo/test-story path usable when a newly seeded student has
      // no interests. In that case the theme is the story, not a student claim.
      const questionTheme = interests || selectedConcept.title;
      const learningContext = ['strengths', 'challenges', 'struggles', 'supports', 'notes']
        .map(section => {
          const content = sectionText(section);
          return content ? `${section}: ${content}` : '';
        }).filter(Boolean).join('\n');

      const response = await fetch('/api/preps', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          student: student?.name || studentId,

          interest: questionTheme,
          competencies: [competencyId],
          educator_prompt: [
            `Learning objective: ${objective.trim()}`,
            teacherInstructions.trim(),
            `Story premise: ${selectedConcept.premise}`,
            `Use the student's interests in the actual question wording while preserving the original mathematics and answer. Interests: ${questionTheme}`,
            learningContext ? `Student learning context (adapt wording and supports, do not change the academic competency):\n${learningContext}` : '', 
          ]
            .filter(Boolean)
            .join('\n'),
          per_competency: 5,
        }),
      });

      const data: Prep = await readJson(response);
      setPrep(data);
      setDrafts(
        Object.fromEntries(
          data.questions.map(question => [question.id, question.text])
        )
      );
    } catch (err) {
      setError(
        err instanceof Error ? err.message : 'Unable to prepare questions'
      );
    } finally {
      setLoadingQuestions(false);
    }
  }

  async function changeQuestion(
    questionId: string,
    action: 'edit' | 'reject' | 'regenerate',
    payload?: object
  ) {
    if (!prep) return;

    setBusyQuestionId(questionId);
    setError(null);
    setAssembledLesson(null);

    try {
      const response = await fetch(
        `/api/preps/${encodeURIComponent(prep.id)}/questions/${encodeURIComponent(questionId)}/${action}`,
        {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          ...(payload ? { body: JSON.stringify(payload) } : {}),
        }
      );

      const updated: PrepQuestion = await readJson(response);

      setPrep(current =>
        current
          ? {
              ...current,
              questions: current.questions.map(question =>
                question.id === questionId ? updated : question
              ),
            }
          : current
      );

      setDrafts(current => ({
        ...current,
        [questionId]: updated.text,
      }));
    } catch (err) {
      setError(
        err instanceof Error ? err.message : 'Unable to update question'
      );
    } finally {
      setBusyQuestionId(null);
    }
  }

  // ------------------------------------------------------------
  // AI-ASSISTED ADDITION: assemblePreview()
  // Purpose: Submit teacher-reviewed questions and selected story
  //          to the existing lesson assembly endpoint.
  // Directed by: Edenna Chen
  // Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
  // Notes: Rejects unsaved edits; does NOT save or assign lessons.
  // ------------------------------------------------------------
  async function assemblePreview() {
    if (!prep || !selectedConcept || !studentId) {
      setAssemblyMessage('Select a story and generate questions first.');
      return;
    }

    const included = prep.questions.filter(q => q.status !== 'rejected');
    if (!included.length) {
      setAssemblyMessage('Keep at least one question before assembling.');
      return;
    }
    if (included.some(q => (drafts[q.id] ?? q.text) !== q.text)) {
      setAssemblyMessage('Save all question edits before assembling the lesson.');
      return;
    }
    if (included.some(q => !q.text.trim())) {
      setAssemblyMessage('Every included question must contain text.');
      return;
    }

    // AI-ASSISTED ADDITION: Validate numeric difficulty before sending JSON.
    if (included.some(q => !Number.isFinite(Number(q.difficulty)))) {
      setAssemblyMessage('Question difficulty must be numeric. Check the question data.');
      return;
    }
    setAssembling(true);
    setAssemblyMessage('Assembling lesson. Waiting for the story sequence...');
    setError(null);
    setAssembledLesson(null);
    setPreparedSequence(null);
    setAnimationMessage(null);
    try {
      const response = await fetch('/api/lessons/assemble', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          student_id: studentId,
          objective: objective.trim(),
          story_concept: selectedConcept,
          questions: included.map(q => ({
            id: q.id,
            competency: q.competency,
            difficulty: Number(q.difficulty),
            text: q.text,
            // The backend requires "ok"; edited questions were
            // explicitly reviewed and saved by the teacher here.
            status: 'ok',
          })),
          // AI-ASSISTED MODIFICATION: Pass teacher-selected language level to assembly.
          pacing: { ...pacing, story_complexity: storyComplexity },
          teacher_approved: true,
        }),
      });
      const lesson: AssembledLesson = await readJson(response);
      setAssembledLesson(lesson);
      setAssemblyMessage('Lesson assembled. Preview is below.');
      window.setTimeout(() => document.getElementById('assembled-lesson-preview')?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 0);
    } catch (err) {
      setAssemblyMessage(err instanceof Error ? err.message : 'Unable to assemble lesson');
    } finally {
      setAssembling(false);
    }
  }

  // AI-assisted addition (2026-11-05): Select an MVP animation from scene verbs.
  // Design heuristic; not an externally sourced animation taxonomy.
  function inferSceneAction(description: string): string {
    const value = description.toLowerCase();
    if (/mine|dig|pickaxe|ore/.test(value)) return 'mine';
    if (/collect|gather|inventory|pick up/.test(value)) return 'collect';
    if (/build|construct|place block|bridge/.test(value)) return 'build';
    if (/walk|travel|cross|move/.test(value)) return 'walk';
    if (/open|chest|treasure/.test(value)) return 'open';
    return 'reveal';
  }

  // AI-assisted addition: Generate scene images in order using the backend.
  // Reference: Fetch API https://developer.mozilla.org/en-US/docs/Web/API/Fetch_API
  // No grading, lesson assignment, or student-progress persistence occurs here.
  async function prepareAnimatedLesson() {
    if (!assembledLesson || preparingAnimation) return;
    setPreparingAnimation(true);
    setAnimationMessage('Preparing sequential story scenes...');
    setPreparedSequence(null);
    try {
      const questions = assembledLesson.activities.flatMap(activity => activity.questions);
      const scenes = [
        {
          description: assembledLesson.introduction_visual_prompt || assembledLesson.introduction,
          action: 'reveal',
        },
        ...questions.flatMap(question => {
          const action = inferSceneAction([
            question.visual_prompt, question.narrative, question.story_dialogue,
            question.challenge_transition, question.success_event,
          ].filter(Boolean).join(' '));
          const before = [question.before_visual_prompt, question.visual_prompt,
            question.narrative, question.text].filter(Boolean).join('. ');
          const after = [question.after_visual_prompt, question.success_event,
            question.story_bridge, question.challenge_transition].filter(Boolean).join('. ');
          return [
            { description: `BEFORE CHALLENGE: ${before}. Show the obstacle or learning objects BEFORE the action; leave the task visibly incomplete.`, action: 'reveal' },
            { description: `AFTER CHALLENGE: ${after || `The ${action} task is completed`}. Show the SAME location with the obstacle visibly changed/completed; retain all earlier world changes.`, action },
          ];
        }),
        {
          description: assembledLesson.conclusion_visual_prompt || assembledLesson.conclusion,
          action: 'reveal',
        },
      ];
      const response = await fetch('/api/lesson-sequences/prepare', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          lesson_id: assembledLesson.lesson_id,
          story_title: assembledLesson.story.title,
          setting: [assembledLesson.story.premise, assembledLesson.story.story_goal]
            .filter(Boolean).join('. '),
          scenes,
          story_complexity: assembledLesson.story_complexity || storyComplexity,
        }),
      });
      const data = await readJson(response);
      setPreparedSequence(data);
      setAnimationMessage(`Prepared ${data.scenes.length} saved frames (before/after each challenge).`);
    } catch (err) {
      setAnimationMessage(err instanceof Error ? err.message : 'Unable to prepare scenes');
    } finally {
      setPreparingAnimation(false);
    }
  }

  const reviewCount = prep?.questions.filter(
    question => question.status !== 'rejected'
  ).length ?? 0;

  return (
    <div className="page narrow">
      <p className="eyebrow">TEACHER TOOLS</p>
      <h1>Create a lesson</h1>
      <p className="lead">
        Choose a student, generate a personalized storyline, and
        review academic questions before approval.
      </p>

      <div className="card">
        <h2>1. Lesson setup</h2>

        <label htmlFor="lesson-student">Student</label>
        <select
          id="lesson-student"
          value={studentId}
          disabled={loadingStories || loadingQuestions}
          onChange={event => {
            setStudentId(event.target.value);
            clearGeneratedWork();
          }}
        >
          {students.map(student => (
            <option key={student.id} value={student.id}>
              {student.name}
            </option>
          ))}
        </select>

        {/* TEACHER_STUDENT_PIPELINE_DEMO_2026: Teacher sees the real selected record. */}
        {selectedStudent && (
          <section aria-label="Selected student profile" style={{border:'1px solid #cbd5e1', borderRadius:12, padding:16, margin:'14px 0 20px', background:'#f8fafc'}}>
            <p className="eyebrow">SELECTED STUDENT PROFILE · TEACHER VIEW</p>
            <h3 style={{margin:'4px 0 8px'}}>{selectedStudent.name}</h3>
            {profileText('grade_level') && <p><strong>Grade:</strong> {profileText('grade_level')}</p>}
            {(fullStudentProfile?.interests?.ai_summary || profileText('interests')) && <p><strong>Interests:</strong> {fullStudentProfile?.interests?.ai_summary || profileText('interests')}</p>}
            {profileText('interests_text') && <p><strong>Interest notes:</strong> {profileText('interests_text')}</p>}
            {profileText('learning_preferences') && <p><strong>Learning preferences:</strong> {profileText('learning_preferences')}</p>}
            {profileText('learning_preferences_text') && <p><strong>Learning preferences:</strong> {profileText('learning_preferences_text')}</p>}
            {profileText('strengths') && <p><strong>Strengths:</strong> {profileText('strengths')}</p>}
            {profileText('supports') && <p><strong>Supports:</strong> {profileText('supports')}</p>}
            {fullStudentProfile && Object.entries(fullStudentProfile).map(([section, details]) => {
              const summary = details?.ai_summary?.trim();
              const notes = details?.teacher_notes ?? [];
              if (!summary && notes.length === 0) return null;
              return <div key={section} style={{marginTop: 10}}>
                <strong>{section.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}:</strong>
                {summary && <p>{summary}</p>}
                {notes.map((note, i) => <p key={i}><strong>Teacher note:</strong> {note.note_text}</p>)}
              </div>;
            })}
            <p className="muted small">Profile summaries and teacher notes are loaded from the saved student profile.</p>
          </section>
        )}

        {/* ------------------------------------------------------------
            AI-ASSISTED MODIFICATION: Competency before story generation.
            Purpose: Anchor story generation and academic questions to
                     the same selected competency.
            Directed by: Edenna Chen
            Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
            ------------------------------------------------------------ */}
        <label htmlFor="lesson-competency">Academic competency</label>
        <select
          id="lesson-competency"
          value={competencyId}
          onChange={event => {
            // AI-ASSISTED MODIFICATION: Keep suggested objective aligned
            // whenever the teacher selects another competency.
            const nextId = event.target.value;
            const selected = competencies.find(item => item.id === nextId);
            setCompetencyId(nextId);
            setObjective(selected ? getSuggestedObjective(selected) : '');
            clearGeneratedWork();
          }}
        >
          {competencies.map(competency => (
            <option key={competency.id} value={competency.id}>
              {competency.name || competency.label || competency.description || competency.id}
            </option>
          ))}
        </select>
        <p className="muted small">Choose the academic competency before generating the story.</p>

        <label htmlFor="lesson-objective">Learning objective</label>
        <input
          id="lesson-objective"
          value={objective}
          onChange={event => {
            setObjective(event.target.value);
            clearGeneratedWork();
          }}
          placeholder="What should the student learn?"
        />

        {/* AI-ASSISTED ADDITION (2026-11-05): Language level for generated mission and story text. */}
        <label htmlFor="lesson-story-language">Story language</label>
        <select
          id="lesson-story-language"
          value={storyComplexity}
          onChange={event => {
            setStoryComplexity(event.target.value as 'simple' | 'moderate' | 'rich');
            setAssembledLesson(null);
            setAssemblyMessage(null);
          }}
        >
          <option value="simple">Low</option>
          <option value="moderate">Moderate</option>
          <option value="rich">Rich</option>
        </select>
        <p className="muted small">
          Controls story wording, visual density, and scene motion; not academic difficulty or approved questions.
        </p>

        <label htmlFor="lesson-instructions">
          Additional teacher instructions (optional)
        </label>
        <textarea
          id="lesson-instructions"
          value={teacherInstructions}
          onChange={event => {
            setTeacherInstructions(event.target.value);
            clearGeneratedWork();
          }}
          placeholder="For example: Use visual examples and short steps."
          rows={4}
          style={{
            display: 'block',
            width: '100%',
            padding: 13,
            borderRadius: 10,
            border: '1px solid #d9c8c1',
            background: '#fffdf8',
            font: 'inherit',
          }}
        />

        <button
          type="button"
          className="btn primary"
          disabled={loadingStories || !studentId || !competencyId || !objective.trim()}
          onClick={generateConcepts}
        >
          {loadingStories ? 'Generating stories...' : 'Generate story concepts'}
        </button>


        {/*
        AI-assisted addition: Temporary test-story button.
        Purpose: Load a predefined story without calling the story-generation API.

        Directed by: Edenna Chen
        Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
        Human edits: Pending review
        External sources: None

        Note: Remove or disable before production deployment.
        */}
        <button
        type="button"
        className="btn"
        onClick={useTestStory}
        >
        Use test story (no API call)
        </button>

      </div>

      

      {error && (
        <div className="card" role="alert">
          <strong>Something went wrong</strong>
          <p>{error}</p>
        </div>
      )}

      {concepts.length > 0 && (
        <div className="card">
          <h2>2. Choose a story concept</h2>
          <p className="muted">
            Select the storyline that best fits this student.
          </p>

          {concepts.map(concept => (
            <button
              key={concept.id}
              type="button"
              onClick={() => {
                setSelectedConceptId(concept.id);
                setPrep(null);
                setDrafts({});
                setAssembledLesson(null);
              }}
              style={{
                display: 'block',
                width: '100%',
                textAlign: 'left',
                padding: 20,
                marginTop: 14,
                borderRadius: 14,
                border:
                  selectedConceptId === concept.id
                    ? '2px solid #d8a83d'
                    : '1px solid #e8ddd5',
                background:
                  selectedConceptId === concept.id
                    ? '#fff5da'
                    : '#fffdf8',
                color: '#392a2d',
              }}
            >
              <strong>{concept.title}</strong>
              <p>{concept.premise}</p>
              <p className="muted small">
                <strong>Story goal:</strong> {concept.story_goal}
              </p>
              <p className="muted small">
                <strong>Learning connection:</strong>{' '}
                {concept.learning_connection}
              </p>
            </button>
          ))}
        </div>
      )}

      {selectedConcept && (
        <div className="card">
          <h2>3. Selected storyline</h2>
          <p><strong>{selectedConcept.title}</strong></p>
          <p>{selectedConcept.premise}</p>

          <p className="muted small">
            Academic competency: <strong>{competencies.find(c => c.id === competencyId)?.name || competencies.find(c => c.id === competencyId)?.label || competencyId}</strong>
          </p>

          <button
            type="button"
            className="btn primary"
            disabled={loadingQuestions || !competencyId}
            onClick={generateQuestions}
          >
            {loadingQuestions
              ? 'Preparing questions...'
              : 'Generate academic questions'}
          </button>
        </div>
      )}

      {prep && (
        <div className="card">
          <h2>4. Review academic questions</h2>
          <p className="muted">
            {reviewCount} of {prep.questions.length} questions included.
            Edit wording, reject questions, or regenerate a storyline.
          </p>

          {prep.questions.map((question, index) => (
            <div
              key={question.id}
              style={{
                padding: 18,
                marginTop: 16,
                border: '1px solid #e8ddd5',
                borderRadius: 12,
                background:
                  question.status === 'rejected'
                    ? '#f3eeeb'
                    : '#fffdf8',
              }}
            >
              <p>
                <strong>Question {index + 1}</strong>
                {' · '}
                {question.competency}
                {' · '}
                {question.difficulty}
              </p>

              <p className="muted small">
                <strong>Original:</strong> {question.original}
              </p>

              <label htmlFor={`question-${question.id}`}>
                Student-facing wording
              </label>
              <textarea
                id={`question-${question.id}`}
                rows={3}
                value={drafts[question.id] ?? question.text}
                disabled={busyQuestionId !== null}
                onChange={event =>
                  {
                    setAssembledLesson(null);
                    setDrafts(current => ({
                      ...current,
                      [question.id]: event.target.value,
                    }));
                  }
                }
                style={{
                  display: 'block',
                  width: '100%',
                  padding: 12,
                  borderRadius: 10,
                  border: '1px solid #d9c8c1',
                  background: '#fff',
                  font: 'inherit',
                }}
              />

              {question.flagged && (
                <p style={{ color: '#9a5424' }}>
                  Review recommended: {question.note ||
                    'Some original numbers may be missing.'}
                </p>
              )}

              <p className="muted small">
                Status: <strong>{question.status}</strong>
              </p>

              <div
                style={{
                  display: 'flex',
                  flexWrap: 'wrap',
                  gap: 8,
                }}
              >
                <button
                  type="button"
                  className="btn"
                  disabled={
                    busyQuestionId !== null ||
                    !(drafts[question.id] ?? '').trim() ||
                    drafts[question.id] === question.text
                  }
                  onClick={() =>
                    changeQuestion(question.id, 'edit', {
                      text: drafts[question.id],
                    })
                  }
                >
                  Save edit
                </button>

                <button
                  type="button"
                  className="btn"
                  disabled={busyQuestionId !== null}
                  onClick={() =>
                    changeQuestion(question.id, 'regenerate')
                  }
                >
                  Regenerate
                </button>

                <button
                  type="button"
                  className="btn"
                  disabled={busyQuestionId !== null}
                  onClick={() =>
                    changeQuestion(question.id, 'reject', {
                      rejected: question.status !== 'rejected',
                    })
                  }
                >
                  {question.status === 'rejected'
                    ? 'Restore'
                    : 'Reject'}
                </button>
              </div>
            </div>
          ))}

          {/* AI-assisted addition: Explicit teacher-reviewed assembly action. */}
          <p className="muted small" style={{ marginTop: 20 }}>
            Review the included questions and save any edits before assembling.
            This creates a preview only; it does not assign the lesson.
          </p>
          <button
            type="button"
            className="btn primary"
            disabled={assembling || busyQuestionId !== null || reviewCount === 0}
            onClick={assemblePreview}
          >
            {assembling ? 'Assembling lesson...' : 'Review & Assemble Lesson'}
          </button>
          {assemblyMessage && (
            <p role="status" aria-live="polite" style={{ marginTop: 12 }}>
              {assemblyMessage}
            </p>
          )}
        </div>
      )}

      {/*
        AI-ASSISTED UPDATE: Expanded teacher-only lesson preview.
        Purpose: Review refresher, dialogue, challenge, optional help,
                 visual descriptions, finale, and alignment warnings.
        Directed by: Edenna Chen
        Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
        Notes: Does not generate artwork, persist, or assign lessons.
      */}
      {/* AI-ASSISTED ADDITION (2026-11-05): Interactive local rendering of
          the assembled lesson. The existing detailed teacher preview remains below. */}
      {/* AI-assisted addition: Explicit teacher action; this makes paid image API calls. */}
      {assembledLesson && (
        <div className="card" style={{ marginTop: 24 }}>
          <h2>Prepare animated lesson</h2>
          <p className="muted small">
            Generate and save connected scene illustrations for this reviewed lesson.
            The student player is not connected to these saved scenes yet.
          </p>
          <button
            type="button"
            className="btn primary"
            disabled={preparingAnimation}
            onClick={prepareAnimatedLesson}
          >
            {preparingAnimation ? 'Preparing animated lesson...' : 'Prepare Animated Lesson'}
          </button>
          {animationMessage && <p role="status" aria-live="polite">{animationMessage}</p>}
          {preparedSequence && (
            <div>
              <p>{preparedSequence.scenes.length} scenes saved for future playback.</p>
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(160px, 1fr))', gap: 12 }}>
                {preparedSequence.scenes.map(scene => (
                  <figure key={scene.index} style={{ margin: 0 }}>
                    <img
                      src={scene.image_url}
                      alt={`Prepared story scene ${scene.index + 1}`}
                      style={{ width: '100%', borderRadius: 8 }}
                    />
                    <figcaption className="muted small">
                      Scene {scene.index + 1} · {scene.animation.action}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          )}
        </div>
      )}

      {assembledLesson && (
        <section aria-label="Interactive lesson rendering" style={{ marginTop: 24 }}>
          <h2>Student-facing lesson rendering</h2>
          <p><strong>Previewing as:</strong> {selectedStudent?.name ?? 'Selected student'}</p>
          <p className="muted small">
            Local rendering only. Simulated progress is not saved and no lesson is assigned.
          </p>
          <LessonRenderer key={`${assembledLesson.lesson_id}:${studentId}`} lesson={toRenderableLesson(assembledLesson)} studentName={selectedStudent?.name} studentInterests={profileText('interests')} studentId={studentId} preparedSequence={preparedSequence?.lesson_id === assembledLesson.lesson_id ? preparedSequence : null} />
        </section>
      )}

      {assembledLesson && (
        <div className="card" id="assembled-lesson-preview">
          <h2>5. Assembled lesson preview</h2>
          <p><strong>{assembledLesson.story.title}</strong></p>
          <p className="muted small">
            Story complexity: {assembledLesson.story_complexity ?? 'Not specified'}
            {' · '}Visual style: {String(assembledLesson.story.visual_theme?.style ?? 'Not specified')}
          </p>

          {assembledLesson.alignment_warning && (
            <div role="alert" style={{ border: '2px solid #b7791f', borderRadius: 10, padding: 14, marginTop: 16 }}>
              <strong>Academic alignment — teacher review required</strong>
              <p>{assembledLesson.alignment_warning}</p>
            </div>
          )}

          {/* AI-ASSISTED ADDITION (2026-11-05): Teacher preview of the
              student-facing opening slide. The numbered markers belong to
              the scene layout; the backend still needs real artwork. */}
          <section aria-label="Mission opening slide preview" style={{ marginTop: 22, marginBottom: 24 }}>
            <p className="muted small">Student screen preview · Opening slide</p>
            <div style={{ border: '1px solid #d9dfe7', borderRadius: 18, overflow: 'hidden', background: '#f8fafc', color: '#253246' }}>
              <div style={{ padding: '14px 20px', background: '#ffffff', borderBottom: '1px solid #e4e9ef', display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: 12 }}>
                <strong style={{ fontSize: 13, letterSpacing: '.05em' }}>YOUR MISSION</strong>
                <span style={{ fontSize: 12, color: '#5b6a7e' }}>0 of {getMissionSteps(assembledLesson).length} completed</span>
              </div>
              <div style={{ padding: 22 }}>
                <h3 style={{ margin: '0 0 8px', color: '#253246' }}>{assembledLesson.story.title}</h3>
                <p style={{ margin: '0 0 20px', lineHeight: 1.6 }}>{getMissionGoal(assembledLesson)}</p>
                <div style={{ borderRadius: 16, padding: '22px 18px', background: 'linear-gradient(150deg, #dbe9ee, #e8e9df 60%, #dce5d9)', border: '1px solid #cbd9d8' }}>
                  <p style={{ margin: '0 0 18px', fontSize: 12, fontWeight: 700, letterSpacing: '.06em', color: '#3b5561' }}>MISSION STEPS</p>
                  <div style={{ display: 'grid', gap: 10, maxWidth: 480, margin: '0 auto' }}>
                    {getMissionSteps(assembledLesson).map((step, index) => (
                      <div key={`${index}-${step}`} style={{ display: 'flex', alignItems: 'center', gap: 12, padding: '10px 13px', background: 'rgba(255,255,255,.88)', borderRadius: 12, border: '1px solid rgba(110,136,144,.25)' }}>
                        <span style={{ flexShrink: 0, width: 29, height: 29, borderRadius: 9, background: '#3f6675', color: '#fff', display: 'grid', placeItems: 'center', fontSize: 13, fontWeight: 700 }}>{index + 1}</span>
                        <span style={{ fontWeight: 600, fontSize: 14 }}>{step}</span>
                      </div>
                    ))}
                  </div>
                </div>
                <p style={{ fontSize: 12, color: '#657386', margin: '12px 0 0' }}>
                  Artwork placeholder: scene and step markers can be layered over an approved mission image later.
                </p>
                <details style={{ marginTop: 12, fontSize: 13 }}>
                  <summary>Opening illustration description (teacher only)</summary>
                  <p>{assembledLesson.introduction_visual_prompt || 'No illustration description returned.'}</p>
                </details>
              </div>
            </div>
          </section>

          <h3>Opening story</h3>
          <p>{assembledLesson.introduction}</p>
          {assembledLesson.introduction_visual_prompt && (
            <p className="muted small"><strong>Scene description:</strong> {assembledLesson.introduction_visual_prompt}</p>
          )}

          {assembledLesson.refresher && (
            <section style={{ padding: 16, marginTop: 16, border: '1px solid #e8ddd5', borderRadius: 12 }}>
              <h3>Intro / academic refresher</h3>
              {typeof assembledLesson.refresher === 'string' ? (
                <p>{assembledLesson.refresher}</p>
              ) : (
                <>
                  {assembledLesson.refresher.concept && <p><strong>Concept:</strong> {assembledLesson.refresher.concept}</p>}
                  {assembledLesson.refresher.explanation && <p>{assembledLesson.refresher.explanation}</p>}
                  {typeof assembledLesson.refresher.worked_example === 'string' ? (
                    <p><strong>Worked example:</strong> {assembledLesson.refresher.worked_example}</p>
                  ) : assembledLesson.refresher.worked_example ? (
                    <div>
                      <strong>Worked example</strong>
                      {assembledLesson.refresher.worked_example.question && <p>{assembledLesson.refresher.worked_example.question}</p>}
                      {assembledLesson.refresher.worked_example.steps?.map((step, index) => <p key={index}>{index + 1}. {step}</p>)}
                      {assembledLesson.refresher.worked_example.explanation && <p>{assembledLesson.refresher.worked_example.explanation}</p>}
                      {assembledLesson.refresher.worked_example.answer && <p><strong>Example answer:</strong> {assembledLesson.refresher.worked_example.answer}</p>}
                    </div>
                  ) : null}
                </>
              )}
            </section>
          )}

          {assembledLesson.activities.map(activity => (
            <section key={activity.activity_number} style={{ marginTop: 20 }}>
              <h3>Activity {activity.activity_number}</h3>
              {activity.questions.map((question, index) => (
                <div key={question.question_id} style={{ padding: 16, marginBottom: 14, border: '1px solid #e8ddd5', borderRadius: 12 }}>
                  <p className="muted small">Challenge {index + 1} · ID: {question.question_id}</p>
                  {question.story_dialogue && <p><strong>Character:</strong> “{question.story_dialogue}”</p>}
                  {!question.story_dialogue && question.narrative && <p>{question.narrative}</p>}
                  {(question.challenge_transition || question.challenge_prompt) && (
                    <p>{question.challenge_transition ?? question.challenge_prompt}</p>
                  )}
                  <p><strong>Your challenge:</strong> {question.text}</p>
                  {question.instruction && <p><strong>Instruction:</strong> {question.instruction}</p>}
                  {question.worked_example && <p><strong>Example:</strong> {question.worked_example}</p>}
                  {question.visual_prompt && <p className="muted small"><strong>Scene description:</strong> {question.visual_prompt}</p>}
                  {(question.optional_reminder || question.reminder || question.walkthrough?.length) && (
                    <details style={{ marginTop: 12 }}>
                      <summary>Preview optional Ask for Help content</summary>
                      {(question.optional_reminder || question.reminder) && (
                        <p>{question.optional_reminder ?? question.reminder}</p>
                      )}
                      {question.walkthrough?.map((step, stepIndex) => <p key={stepIndex}>{stepIndex + 1}. {step}</p>)}
                    </details>
                  )}
                </div>
              ))}
            </section>
          ))}

          {/* AI-ASSISTED ADDITION (2026-11-05): Separate finale and trophy
              screens in teacher preview. Trophy is a presentation placeholder,
              not an awarded or persisted achievement. */}
          <div style={{ marginTop: 26, padding: 18, borderRadius: 16, background: '#edf3f2', border: '1px solid #d5e2df' }}>
            <p className="muted small">Student screen preview · Mission complete</p>
            <h3 style={{ marginTop: 4 }}>Mission complete</h3>
            <p>{assembledLesson.conclusion}</p>
            <p className="muted small">Completed-scene illustration: {assembledLesson.conclusion_visual_prompt || 'Not yet provided'}</p>
          </div>
          <div style={{ marginTop: 14, padding: 22, borderRadius: 16, textAlign: 'center', background: '#f6f3e9', border: '1px solid #e6dfca' }}>
            <p className="muted small">Student screen preview · Trophy presentation</p>
            <div aria-hidden="true" style={{ fontSize: 38, lineHeight: 1.4 }}>🏆</div>
            <h3 style={{ margin: '8px 0' }}>Mission accomplished!</h3>
            <p style={{ margin: 0 }}>You completed {getMissionSteps(assembledLesson).length} mission steps.</p>
            <p className="muted small" style={{ marginBottom: 0 }}>Trophy artwork and personalized award details can be connected when the backend provides them.</p>
          </div>

          <h3>Finale details (teacher review)</h3>
          <p>{assembledLesson.conclusion}</p>
          {assembledLesson.conclusion_visual_prompt && (
            <p className="muted small"><strong>Scene description:</strong> {assembledLesson.conclusion_visual_prompt}</p>
          )}
          {assembledLesson.finale_animation && (
            <p className="muted small">
              <strong>Optional finale animation:</strong> {assembledLesson.finale_animation.type ?? 'none'}
              {assembledLesson.finale_animation.target ? ` · ${assembledLesson.finale_animation.target}` : ''}
            </p>
          )}
          <p className="muted small">
            Preview only. Lesson ID: {assembledLesson.lesson_id}.
            Student delivery and persistence are not connected yet.
            All generated instruction, examples, and hints require teacher review.
          </p>
        </div>
      )}
    </div>
  );
}