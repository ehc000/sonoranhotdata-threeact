
/**
 * File: Learn.tsx
 *
 * Purpose:
 *   Display the student's current lesson, including instructional
 *   steps, a practice question, feedback, and lesson completion.
 *
 * Original implementation: Existing team project code.
 *
 * AI-assisted additions:
 *   1. Import reusable ListenButton component.
 *   2. Add optional text-to-speech for lesson instructions.
 *   3. Add optional text-to-speech for the practice question.
 *   4. Reformat existing code for readability and maintenance.
 *
 * Directed by: Edenna Chen
 * Modifications generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
 * Human edits: Pending review
 * External sources: None
 *
 * Notes:
 *   - Original lesson content and question logic are preserved.
 *   - Text-to-speech is initiated by the student, never autoplayed.
 *   - This page currently uses mock lesson data.
 *   - Generated stories and visuals will be integrated separately.
 */

import { useState } from 'react';
import { lessonSteps } from '../../data/mock';
import type { Student } from '../../types';
import ProgressBar from '../../components/ProgressBar';

// AI ADDITION: Reusable browser text-to-speech component.
import ListenButton from '../../components/ListenButton';

export default function Learn({
  student,
  onComplete,
}: {
  student: Student;
  onComplete: () => void;
}) {
  // ORIGINAL: Track the current instructional step.
  const [step, setStep] = useState(0);

  // ORIGINAL: Track the student's selected answer.
  const [answer, setAnswer] = useState('');

  // ORIGINAL: Track whether the answer has been checked.
  const [checked, setChecked] = useState(false);

  // ORIGINAL: Prevent duplicate completion callbacks.
  const [completed, setCompleted] = useState(false);

  const correct = answer === 'correct';

  return (
    <div className="page narrow">
      <p className="eyebrow">EXAMPLE LESSON · MOCK CONTENT</p>

      <h1>Equal parts, made simple</h1>

      <p className="lead">
        One idea at a time. Go at your own pace.
      </p>

      <section className="card" aria-label="Example competency learning path" style={{marginBottom:18,padding:'22px 14px'}}>
        <h2 style={{fontSize:23,margin:'0 0 6px'}}>The Pixel Pond Adventure</h2>
        <p className="muted small" style={{marginBottom:6}}>EXAMPLE / MOCK LEARNING PATH · Fictional lessons and achievements, not recorded student progress.</p>
        <p style={{fontSize:13,color:'#56736a',marginTop:0}}>Follow the winding trail, collect trophies, and unlock new skills!</p>
        <div style={{maxWidth:550,margin:'10px auto',position:'relative',aspectRatio:'550 / 710',overflow:'hidden',borderRadius:20,background:'linear-gradient(180deg,#e3f3e6,#d5ebdc 55%,#eaf4dd)',border:'2px solid #b4d3ba'}}>
          <svg viewBox="0 0 550 710" aria-hidden="true" style={{position:'absolute',inset:0,width:'100%',height:'100%'}}>
            <path d="M100 95 C100 160 425 160 425 225 S105 290 105 360 S425 425 425 495 S110 555 110 635" fill="none" stroke="#8caa88" strokeWidth="43" strokeLinecap="round"/>
            <path d="M100 95 C100 160 425 160 425 225 S105 290 105 360 S425 425 425 495 S110 555 110 635" fill="none" stroke="#f5dfab" strokeWidth="33" strokeLinecap="round" strokeDasharray="12 7"/>
            <path d="M100 95 C100 160 425 160 425 225 S105 290 105 360 S425 425 425 495 S110 555 110 635" fill="none" stroke="#d9c18c" strokeWidth="4" strokeLinecap="round" strokeDasharray="3 15"/>
            {Array.from({length:18},(_,i)=><rect key={i} x={(i*83)%520+12} y={(i*137)%680+10} width="7" height="7" fill="#98cba0" opacity=".65"/>)}
          </svg>
          {[
            {x:18,y:7,name:'Slice of Sunshine',skill:'Recognize equal parts',symbol:'sun',done:true},
            {x:77,y:25,name:'The Halfway Bridge',skill:'Identify unit fractions',symbol:'bridge',done:true},
            {x:19,y:45,name:'Frog Pond Puzzles',skill:'Compare fractions',symbol:'frog',done:true},
            {x:77,y:64,name:'Berry Basket Quest',skill:'Add fractions',symbol:'berry',done:false},
            {x:20,y:85,name:'Treasure of the Pond',skill:'Fraction word problems',symbol:'chest',done:false},
          ].map((node,i)=><div key={node.name} style={{position:'absolute',left:`${node.x}%`,top:`${node.y}%`,transform:'translate(-50%,-10%)',width:'37%',display:'flex',alignItems:'center',flexDirection:'column',textAlign:'center',zIndex:2}}>
            <div style={{position:'relative',width:65,height:58,display:'grid',placeItems:'center',background:node.done?'#75b86d':'#b6c7a8',border:'4px solid #426e4d',borderRadius:'48% 48% 42% 42%',boxShadow:'0 6px 0 #517b5b'}}>
              <svg viewBox="0 0 32 32" width="37" height="37" style={{imageRendering:'pixelated'}} aria-hidden="true">
                {node.symbol==='sun'?<><rect x="12" y="2" width="8" height="28" fill="#e9a640"/><rect x="2" y="12" width="28" height="8" fill="#e9a640"/><rect x="8" y="8" width="16" height="16" fill="#ffe28c"/></>:null}
                {node.symbol==='bridge'?<><rect x="3" y="18" width="26" height="6" fill="#82593d"/><rect x="5" y="12" width="5" height="17" fill="#a8784b"/><rect x="22" y="12" width="5" height="17" fill="#a8784b"/><rect x="11" y="9" width="10" height="5" fill="#c99b67"/></>:null}
                {node.symbol==='frog'?<><rect x="5" y="12" width="22" height="15" fill="#4b9c59"/><rect x="7" y="6" width="7" height="9" fill="#4b9c59"/><rect x="19" y="6" width="7" height="9" fill="#4b9c59"/><rect x="9" y="10" width="3" height="3" fill="#1e3d32"/><rect x="21" y="10" width="3" height="3" fill="#1e3d32"/><rect x="12" y="22" width="9" height="2" fill="#e1eb9d"/></>:null}
                {node.symbol==='berry'?<><rect x="10" y="7" width="13" height="6" fill="#5b9c4c"/><rect x="6" y="13" width="20" height="14" fill="#a33e65"/><rect x="12" y="16" width="3" height="3" fill="#f7b6c4"/><rect x="19" y="21" width="3" height="3" fill="#f7b6c4"/></>:null}
                {node.symbol==='chest'?<><rect x="4" y="11" width="24" height="17" fill="#79523a"/><rect x="6" y="9" width="20" height="7" fill="#c58c4b"/><rect x="14" y="14" width="5" height="9" fill="#f2d06c"/></>:null}
              </svg>
              <span aria-label={node.done?'Mock trophy earned':'Mock lesson locked'} style={{position:'absolute',right:-15,top:-13,fontSize:21,filter:'drop-shadow(0 1px 1px #fff)'}}>{node.done?'🏆':'🔒'}</span>
            </div>
            <div style={{marginTop:9,padding:'5px 7px',borderRadius:9,background:'#fffdf1',border:'1px solid #9ab6a1',boxShadow:'0 2px 0 #bfd6be',width:'100%'}}>
              <strong style={{fontSize:12,display:'block',color:'#314b3c',lineHeight:1.2}}>{i+1}. {node.name}</strong>
              <span style={{fontSize:10,display:'block',color:'#58716b',marginTop:3}}>Competency: {node.skill}</span>
            </div>
          </div>)}
        </div>
      </section>
      <div className="card lesson-card">
        <div className="lesson-top">
          <span className="tag">
            STEP {step + 1} OF {lessonSteps.length}
          </span>

          <span className="muted small">
            {student.pace}
          </span>
        </div>

        {/* ORIGINAL: Lesson progress indicator. */}
        <ProgressBar
          value={((step + 1) / lessonSteps.length) * 100}
        />

        {/* ORIGINAL: Placeholder visual for fractions. */}
        <div
          className="lesson-visual"
          aria-label="A circle divided into two equal halves"
        >
          ◐
        </div>

        {/* ORIGINAL: Display current instructional step. */}
        <h2>{lessonSteps[step]}</h2>

        {/*
          AI ADDITION: Read the current lesson instruction aloud.

          Uses the same text already displayed on screen.
          The student can start or stop narration manually.
        */}
        <ListenButton
          text={lessonSteps[step]}
          label="Listen to lesson"
        />

        {/* ORIGINAL: Show the practice question on the final step. */}
        {step === lessonSteps.length - 1 ? (
          <>
            <p className="question">
              What does one-half mean?
            </p>

            {/*
              AI ADDITION: Read the practice question aloud.

              This is separate from the instructional narration,
              allowing students to replay only the question.
            */}
            <ListenButton
              text="What does one-half mean?"
              label="Listen to question"
            />

            {/* ORIGINAL: Multiple-choice answer options. */}
            <div className="answer-list">
              {[
                ['correct', 'One of two equal parts'],
                ['incorrect', 'One of three equal parts'],
              ].map(([value, label]) => (
                <label
                  key={value}
                  className={
                    'answer ' +
                    (answer === value ? 'picked' : '')
                  }
                >
                  <input
                    type="radio"
                    name="fraction-answer"
                    checked={answer === value}
                    onChange={() => {
                      setAnswer(value);
                      setChecked(false);
                    }}
                  />

                  {label}
                </label>
              ))}
            </div>

            {/* ORIGINAL: Answer feedback. */}
            {checked && (
              <p
                className={
                  correct
                    ? 'feedback success'
                    : 'feedback hint'
                }
                role="status"
              >
                {correct
                  ? 'Correct! You found the equal parts.'
                  : 'Not quite. Look for two equal-sized pieces.'}
              </p>
            )}

            {/* ORIGINAL: Lesson completion message. */}
            {completed && (
              <p
                className="feedback success"
                role="status"
              >
                Lesson complete! Your demo progress was updated.
              </p>
            )}

            {/* ORIGINAL: Check answer and update completion. */}
            <button
              className="btn primary"
              disabled={!answer || completed}
              onClick={() => {
                setChecked(true);

                if (correct && !completed) {
                  setCompleted(true);
                  onComplete();
                }
              }}
            >
              Check answer
            </button>
          </>
        ) : (
          /* ORIGINAL: Advance to the next instructional step. */
          <button
            className="btn primary"
            onClick={() => setStep((x) => x + 1)}
          >
            Next step →
          </button>
        )}

        {/* ORIGINAL: Restart the lesson. */}
        <button
          className="btn ghost"
          onClick={() => {
            setStep(0);
            setAnswer('');
            setChecked(false);
            setCompleted(false);
          }}
        >
          Restart lesson
        </button>
      </div>
    </div>
  );
}
