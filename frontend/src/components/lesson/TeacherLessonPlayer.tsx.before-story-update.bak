/**
 * Teacher preview = same playable student-facing flow, using approved assembled lesson.
 * No grading, saving, assignment, or avatar-growth events in this demo.
 * Original classroom game illustrations; no image API dependency.
 */
import { useEffect, useState } from 'react';
import LessonAvatarSprite from './LessonAvatarSprite';
import type { LessonAvatarChoice } from './LessonAvatarSprite';
import type { RenderableLesson, PreparedLessonSequence } from './LessonRenderer';

type Props = { lesson: RenderableLesson; studentName?: string; studentInterests?: string; studentId?: string; preparedSequence?: PreparedLessonSequence | null };
type Phase = 'intro'|'refresher'|'question'|'success'|'finale';
const button: React.CSSProperties={padding:'11px 16px',borderRadius:9,border:'2px solid #687a95',background:'#fff',color:'#27364b',fontWeight:700,cursor:'pointer'};
function sceneKind(lesson:RenderableLesson):'mine'|'space'|'forest'|'castle'{
 const content=[lesson.story?.title,lesson.mission?.title,lesson.introduction,...lesson.activities.flatMap(a=>a.questions.map(q=>q.visual_prompt||q.before_visual_prompt||q.text))].join(' ').toLowerCase();
 if(/mine|minecraft|cave|underground|lava|ore|inventory/.test(content))return 'mine';
 if(/space|mars|planet|rover|rocket|galaxy/.test(content))return 'space';
 if(/forest|animal|tree|garden|nature|plant/.test(content))return 'forest';
 return 'castle';
}
function Background({kind,progress,finale,avatar,imageUrl,hideAvatar}: {kind:ReturnType<typeof sceneKind>;progress:number;finale:boolean;avatar:LessonAvatarChoice|null;imageUrl:string|null;hideAvatar?:boolean}){
 const sky=kind==='space'?'#293454':kind==='mine'?'#b9d0da':'#dcebf3';
 const earth=kind==='space'?'#997da8':kind==='mine'?'#a98467':'#7bc46e';
 return <svg viewBox="0 0 800 360" role="img" aria-label={`${kind} illustrated interactive mission with student avatar`} style={{width:'100%',display:'block',borderRadius:12,imageRendering:'pixelated',background:sky}}>
   {!imageUrl&&(kind==='space'?<><circle cx="674" cy="70" r="43" fill="#f4dfac"/>{Array.from({length:26},(_,i)=><rect key={i} x={(i*127)%780+5} y={(i*67)%170+8} width="4" height="4" fill="#f9e9ae"/>)}</>:<><path d="M0 192L125 82L220 192L335 67L500 194L630 96L800 186V260H0Z" fill={!imageUrl&&kind==='mine'?'#8fabb3':'#92b7c5'}/><path d="M0 235L180 145L300 230L530 143L800 233V270H0Z" fill="#719caa"/></>)}
   {!imageUrl&&<rect x="0" y="257" width="800" height="103" fill={earth}/>}
   {!imageUrl&&kind==='mine'?<>{Array.from({length:18},(_,i)=><rect key={i} x={(i*103)%800} y={269+(i*29)%80} width="24" height="14" fill={i%3===0?'#d8b16b':'#896b56'}/>)}<rect x="637" y="190" width="116" height="78" fill="#5b647b"/><rect x="650" y="205" width="90" height="47" fill="#9c78ad"/><rect x="683" y="220" width="24" height="31" fill="#473c60"/></>:null}
   {!imageUrl&&kind==='space'?<><path d="M640 259L692 180L748 259Z" fill="#d4d9e6" stroke="#586884" strokeWidth="8"/><rect x="680" y="215" width="20" height="39" fill="#e4a074"/></>:null}
   {!imageUrl&&kind==='forest'?Array.from({length:6},(_,i)=><g key={i} transform={`translate(${i*145} 0)`}><rect x="50" y="182" width="20" height="80" fill="#80674d"/><path d="M15 207L60 115L105 207Z" fill="#4b9b80"/><path d="M27 172L60 100L94 172Z" fill="#70b5a1"/></g>):null}
   {!imageUrl&&kind==='castle'?<><rect x="648" y="171" width="110" height="95" fill="#bcbac4" stroke="#626b82" strokeWidth="7"/><rect x="671" y="210" width="28" height="56" fill="#626b82"/><rect x="631" y="147" width="26" height="119" fill="#bcbac4" stroke="#626b82" strokeWidth="6"/></>:null}
   {imageUrl&&<image href={imageUrl} x="0" y="0" width="800" height="360" preserveAspectRatio="xMidYMid slice"/>}
   {!imageUrl&&<path d="M0 271H800" stroke={!imageUrl&&kind==='mine'?'#d1a37d':'#d0d2c7'} strokeWidth="9" strokeDasharray="30 10"/>}
   {!hideAvatar&&<g style={{transform:`translate(${90+Math.min(1,progress)*560}px, 160px)`,transition:avatar?.static_mode?'none':'transform 550ms ease'}}>
     <LessonAvatarSprite choice={avatar}/>
   </g>}
   {finale&&<g fill="#ffe4a2">{Array.from({length:8},(_,i)=><path key={i} transform={`translate(${180+i*65} ${75+(i%3)*35})`} d="M0 -10L3 -3L10 0L3 3L0 10L-3 3L-10 0L-3 -3Z"/>)}</g>}
 </svg>;
}
export default function TeacherLessonPlayer({lesson,studentName,preparedSequence}:Props){
 const questions=lesson.activities.flatMap(a=>a.questions);
 const [phase,setPhase]=useState<Phase>('intro');
 const [index,setIndex]=useState(0);
 const [showHelp,setShowHelp]=useState(false);
 const [avatar]=useState<LessonAvatarChoice|null>(()=>{
  try{const raw=localStorage.getItem('sonoran-lesson-avatar-preview');return raw?JSON.parse(raw) as LessonAvatarChoice:null}catch{return null}
 });
 useEffect(()=>{setPhase('intro');setIndex(0);setShowHelp(false)},[lesson.lesson_id]);
 const q=questions[index];
 const kind=sceneKind(lesson);
 // AI-assisted: Select ONLY saved images; never invoke image generation in playback.
 // The opening frame is 0; completed challenge N is frame N+1.
 // During a question, retain the last completed frame until success.
 const frame = phase === 'finale' ? questions.length + 1
   : phase === 'success' ? index + 1
   : phase === 'question' ? index
   : 0;
 const scene = preparedSequence?.lesson_id === lesson.lesson_id
   ? preparedSequence.scenes[frame] : undefined;
 const sceneUrl = scene?.image_url ?? null;
 const motion = phase === 'success' ? scene?.animation.action : undefined;
 const effect = phase === 'success' ? scene?.animation.effect : undefined;
 const completed=phase==='finale'?questions.length:index+(phase==='success'?1:0);
 const next=()=>{setShowHelp(false);if(index+1<questions.length){setIndex(i=>i+1);setPhase('question')}else setPhase('finale')};
 return <section aria-label="Interactive student lesson preview" style={{maxWidth:850,margin:'16px auto',color:'#26364c'}}>
   <p style={{fontSize:12,fontWeight:800,letterSpacing:1.3,color:'#8a4961'}}>TEACHER PREVIEW · STUDENT EXPERIENCE</p>
   <h2 style={{margin:'0 0 6px'}}>{lesson.mission?.title||lesson.story?.title||'Your mission'}</h2>
   <p style={{fontSize:13,color:'#64748b'}}>Previewing as {studentName||'student'} · No answers graded or saved</p>
    <div style={{position:'relative',width:'100%',overflow:'hidden',borderRadius:12,aspectRatio:'800 / 360',background:'#dcebf3'}}>
      <Background kind={kind} progress={questions.length?completed/questions.length:0} finale={phase==='finale'} avatar={avatar} imageUrl={sceneUrl} hideAvatar={false}/>
     
            {phase==='question' && q && <div style={{position:'absolute',right:12,bottom:12,zIndex:3,maxWidth:'60%'}}>
         {showHelp && <div role="status" style={{background:'#fffdf0',padding:12,borderRadius:10,marginBottom:8,border:'2px solid #b3a06e',fontSize:13}}>{q.optional_reminder||q.optional_walkthrough?.join(' ')||'Review the refresher and try the next step.'}</div>}
         <button type="button" style={{...button,background:'#fff8d8'}} onClick={()=>setShowHelp(v=>!v)} aria-expanded={showHelp} aria-label="Ask Miguel's companion for a hint">🐾 {showHelp?'Close hint':'Ask companion for hint'}</button>
       </div>}
      {motion && <div key={`${index}-${phase}`} aria-hidden="true" className={`lesson-action lesson-action-${motion}`} style={{position:'absolute',left:'46%',top:'42%',fontSize:42,pointerEvents:'none'}}>{motion==='pickaxe_swing'?'⛏️':motion==='pickup'?'📦':motion==='place_blocks'?'🧱':motion==='walk'?'🚶':motion==='open_chest'?'🗝️':'✨'}</div>}
      {effect && effect !== 'none' && <div key={`effect-${index}-${phase}`} aria-hidden="true" className="lesson-effect" style={{position:'absolute',left:'58%',top:'27%',fontSize:34,pointerEvents:'none'}}>{effect==='ore_sparkles'?'💎':effect==='inventory_glow'?'🎒':effect==='construction_sparkles'?'✨':effect==='treasure_glow'?'🌟':'✨'}</div>}
    </div>
    <style>{`
      @keyframes lesson-swing {0%{transform:rotate(-35deg)}50%{transform:rotate(45deg)}100%{transform:rotate(0)}}
      @keyframes lesson-rise {0%{opacity:0;transform:translateY(24px) scale(.6)}50%{opacity:1}100%{opacity:1;transform:translateY(0) scale(1)}}
      @keyframes lesson-walk {from{transform:translateX(-45px)}to{transform:translateX(40px)}}
      .lesson-action-pickaxe_swing,.lesson-action-open_chest{animation:lesson-swing 900ms ease-in-out both;transform-origin:bottom center}
      .lesson-action-pickup,.lesson-action-place_blocks,.lesson-action-reveal{animation:lesson-rise 900ms ease-out both}
      .lesson-action-walk{animation:lesson-walk 1100ms ease-in-out both}
      .lesson-effect{animation:lesson-rise 1100ms ease-out both}
      @media (prefers-reduced-motion:reduce){.lesson-action,.lesson-effect{animation:none!important}}
    `}</style>
    <p style={{fontSize:12,color:'#64748b'}}>{sceneUrl?'Saved illustration · no image generation during playback':'Illustrated fallback · prepare the lesson to use saved scenes'}</p>
   <div style={{background:'#f0f5f9',border:'1px solid #cbd9e3',borderRadius:12,padding:20,marginTop:12}}>
    <p style={{fontSize:13,fontWeight:700}}>{completed} / {questions.length} mission steps completed</p>
    <progress value={completed} max={Math.max(1,questions.length)} style={{width:'100%'}}/>
    {phase==='intro'&&<><h3>Your mission</h3><p>{lesson.mission?.goal||lesson.story?.story_goal||lesson.objective}</p><p>{lesson.introduction}</p><button style={button} onClick={()=>setPhase('refresher')}>Start mission →</button></>}
    {phase==='refresher'&&<><h3>Quick refresher</h3>{typeof lesson.refresher==='string'?<p>{lesson.refresher}</p>:<><p>{lesson.refresher?.explanation||lesson.objective}</p><p>{typeof lesson.refresher?.worked_example==='string'?lesson.refresher.worked_example:lesson.refresher?.worked_example?.question}</p>{typeof lesson.refresher?.worked_example==='object'&&<ol>{lesson.refresher.worked_example.steps?.map((s,i)=><li key={i}>{s}</li>)}</ol>}</>}<button style={button} onClick={()=>setPhase(questions.length?'question':'finale')}>Try a challenge →</button></>}
    {phase==='question'&&q&&<><p style={{fontSize:12,fontWeight:800}}>CHALLENGE {index+1} OF {questions.length}</p><h3>{q.mission_task_title||`Challenge ${index+1}`}</h3>{q.story_dialogue&&<p>{q.story_dialogue}</p>}{q.narrative&&<p>{q.narrative}</p>}<p style={{fontSize:18,fontWeight:650}}>{q.text}</p><button style={button} onClick={()=>{setPhase('success')}}>Complete demo step →</button><p style={{fontSize:12,color:'#64748b'}}>Demo only: use the complete-step button to simulate progress. No correctness check.</p></>}
    {phase==='success'&&<><h3>Nice progress!</h3><p>{q?.success_event||'Your character moves closer to the goal.'}</p><button style={button} onClick={next}>{index+1<questions.length?'Next challenge →':'Finish mission →'}</button></>}
    {phase==='finale'&&<><h3>Mission complete! ✨</h3><p>{lesson.conclusion}</p><button style={button} onClick={()=>{setIndex(0);setPhase('intro')}}>Replay lesson ↺</button></>}
   </div>
 </section>;
}
