"""Core logic for the educator loop: prep, session, summary, approval, profile.

Purpose: the two loops the rest of the product hooks into. Nothing here
knows about HTTP (see api.py). State is in-memory dicts; swap for a
database by replacing PREPS, SESSIONS and PROFILES.
Directed and reviewed by: Torian Styles
Generated by: Claude (claude.ai chat), model Claude Fable 5.1, 2026-11-02
Human edits: none yet
External sources: none

Loop 1 (prep):     create_prep -> educator edits/rejects/regenerates -> approve_prep
Loop 2 (session):  open/answer/ask_tutor -> finish_session -> approve_review -> profile
The profile feeds the next create_prep (mastery skips easy questions; blockers carry over).

Every prompt text lives in prompts/ and is loaded through prompt_library;
nothing here is sent to a model that is not in those files. All calls go
through backend/llm_query.py, the backend's single model wrapper.
"""

import json
import re
import time
import uuid
from fractions import Fraction

try:  # the backend is run both as a package (uvicorn backend.main:app from the repo root) and from inside backend/
    from .. import llm_query as llm
except ImportError:
    import llm_query as llm  # type: ignore
from . import prompt_library
from .question_bank import BY_ID, COMPETENCIES, questions_for

HELP_CAP = 3  # max tutor turns per question
MASTERED = 0.75  # proficiency thresholds
DEVELOPING = 0.40

PREPS = {}  # prep_id -> prep dict (pre-session, awaiting educator approval)
SESSIONS = {}  # session_id -> session dict
PROFILES = {}  # student name -> profile dict


# ---------------------------------------------------------------- grading

_UNITS = r"(dollars?|cents?|cups?|degrees?|meters?|miles?|hours?|pages?|people|km|cm|\$|%)"


def _normalize(text):
    t = text.strip().lower()
    t = re.sub(r"^[a-z]\s*=\s*", "", t)  # "x = 5" -> "5"
    t = re.sub(_UNITS, "", t)
    t = t.replace(" ", "").rstrip(".")
    return t


def _as_number(t):
    try:
        return Fraction(t)  # handles "3/4", "0.75", "5", "-6"
    except (ValueError, ZeroDivisionError):
        return None


def is_correct(given, expected):
    g, e = _normalize(given), _normalize(expected)
    if ":" in e:  # ratio answers compare as text
        return g == e
    gn, en = _as_number(g), _as_number(e)
    if gn is not None and en is not None:
        return gn == en
    return g == e


# ---------------------------------------------------------------- profiles


def profile_for(student):
    return PROFILES.setdefault(
        student, {"student": student, "interest": "", "competencies": {}, "notes": [], "sessions": 0}
    )


# ---------------------------------------------------------------- prep: selection


def _candidate_pool(competency_ids, profile):
    """Bank questions for the chosen competencies; drop level 1 where the profile shows mastery."""
    pool = []
    for cid in competency_ids:
        known = profile["competencies"].get(cid)
        for q in questions_for(cid):
            if known and known["status"] == "mastered" and q["difficulty"] == 1:
                continue
            pool.append(q)
    return pool


def _spread_pick(pool, competency_ids, per_competency):
    """Deterministic fallback: spread picks across difficulties within each competency."""
    picks = []
    for cid in competency_ids:
        qs = [q for q in pool if q["competency"] == cid]
        by_level = {1: [], 2: [], 3: []}
        for q in qs:
            by_level[q["difficulty"]].append(q)
        chosen, i = [], 0
        while len(chosen) < min(per_competency, len(qs)):
            level = [1, 2, 3][i % 3]
            if by_level[level]:
                chosen.append(by_level[level].pop(0))
            i += 1
            if i > 50:
                break
        picks.extend(chosen)
    return picks


def select_questions(competency_ids, student, educator_prompt, per_competency):
    # Directed and reviewed by: Edenna Chen
    # Generated by: ChatGPT (OpenAI), GPT-6, 2026-11-05
    # Read persistent competency statuses when available.
    # Do not change Torian's scoring or question-selection algorithms.
    from backend.database.competencies import get_student_competencies

    profile = profile_for(student)

    # Work on a copy so database values don't overwrite Torian's
    # existing in-memory session history.
    selection_profile = {
        **profile,
        "competencies": dict(profile["competencies"]),
    }

    for record in get_student_competencies(student):
        if record["status"] in {"mastered", "developing", "struggling"}:
            selection_profile["competencies"][record["competency"]] = {
                "status": record["status"],
                "score": record["mastery_score"],
            }

    pool = _candidate_pool(competency_ids, selection_profile)
    fallback = _spread_pick(pool, competency_ids, per_competency)
    listing = "\n".join(f"{q['id']} [{q['competency']}, level {q['difficulty']}] {q['prompt']}" for q in pool)
    want = {cid: min(per_competency, len([q for q in pool if q["competency"] == cid])) for cid in competency_ids}
    msgs = prompt_library.messages(
        "select_questions", educator_prompt=educator_prompt or "(none)", want=json.dumps(want), pool=listing
    )
    reply = llm.chat_json(
        msgs, prompt_id="select_questions", mock_reply={"ids": [q["id"] for q in fallback]}
    )  # MOCK: deterministic spread
    ids = reply.get("ids") if isinstance(reply, dict) else None
    chosen = [BY_ID[i] for i in ids if i in BY_ID] if ids else []
    # Repair: enforce per-competency counts, fill gaps from the fallback.
    final = []
    for cid in competency_ids:
        got = [q for q in chosen if q["competency"] == cid][: want[cid]]
        if len(got) < want[cid]:
            for q in fallback:
                if q["competency"] == cid and q not in got and len(got) < want[cid]:
                    got.append(q)
        final.extend(got)
    return final, {"llm_ids": ids, "pool_size": len(pool)}


# ---------------------------------------------------------------- prep: rewrap

NUMBER_RE = re.compile(r"-?\d+(?:[./:]\d+)*")


def _numbers_in(text):
    return NUMBER_RE.findall(text)


def check_numbers(original, rewrapped):
    """Every number token in the original must appear in the rewrap. Returns the missing ones."""
    have = _numbers_in(rewrapped)
    loose = re.findall(r"\d+", rewrapped)  # fallback: "3:7" written as "3 to 7" still passes
    missing = []
    for n in _numbers_in(original):
        if n in have:
            have.remove(n)
        elif not n.startswith("-") and all(part in loose for part in re.findall(r"\d+", n)):
            for part in re.findall(r"\d+", n):
                loose.remove(part)
        else:
            missing.append(n)
    return missing


_LEAD = re.compile(r"^(what is|evaluate|simplify|solve for x:|write)\s*", re.I)


def core_expression(prompt):
    """The literal expression/equation in a framing-mode prompt: strip the lead verb, cut at the first sentence end."""
    body = _LEAD.sub("", prompt.strip())
    m = re.search(r"[?]|\.\s|\.$", body)
    return body[: m.start()].strip() if m else body.strip()


def check_rewrap(q, text):
    """Returns (missing_numbers, note). note is set when a framing question lost its literal expression."""
    missing = check_numbers(q["prompt"], text)
    note = None
    if q.get("rewrap") == "framing":
        core = core_expression(q["prompt"])
        if core and core not in text:
            note = f"expression not kept verbatim: {core}"
    return missing, note


def _mock_rewrap(q, interest):
    """MOCK: offline stand-in for the rewrap call; prefixes the interest, changes nothing else."""
    return f"({interest} version) {q['prompt']}" if interest else q["prompt"]


def rewrap_questions(questions, interest):
    """Batched rewrap. Returns {id: {"text": str, "missing": [numbers], "flagged": bool}}."""
    if not interest.strip():
        return {q["id"]: {"text": q["prompt"], "missing": [], "flagged": False} for q in questions}
    listing = {q["id"]: {"mode": q.get("rewrap", "full"), "question": q["prompt"]} for q in questions}
    msgs = prompt_library.messages("rewrap_questions", interest=interest, questions=json.dumps(listing, indent=1))
    reply = llm.chat_json(
        msgs,
        prompt_id="rewrap_questions",
        temperature=0.9,
        mock_reply={"questions": {q["id"]: _mock_rewrap(q, interest) for q in questions}},
    )  # MOCK
    out = {}
    if (
        isinstance(reply, dict)
        and isinstance(reply.get("questions"), dict)
        and any(q["id"] in reply["questions"] for q in questions)
    ):
        reply = reply["questions"]
    for q in questions:
        text = reply.get(q["id"]) if isinstance(reply, dict) else None
        if isinstance(text, dict):  # model echoed the input shape: {id: {mode, question}}
            text = next(
                (v for k in ("question", "text", "rewritten", "prompt") if isinstance(v := text.get(k), str)), None
            ) or next((v for v in text.values() if isinstance(v, str) and len(v) > 12), None)
        if not isinstance(text, str) or not text.strip():
            out[q["id"]] = {
                "text": q["prompt"],
                "missing": [],
                "flagged": True,
                "note": "no rewrap returned; original kept",
            }
            continue
        missing, note = check_rewrap(q, text)
        out[q["id"]] = {"text": text.strip(), "missing": missing, "flagged": bool(missing or note), "note": note}
    return out


# ---------------------------------------------------------------- prep: lifecycle


def create_prep(student, interest, competency_ids, educator_prompt="", per_competency=3):
    bad = [c for c in competency_ids if c not in COMPETENCIES]
    if bad:
        raise ValueError(f"unknown competencies: {bad}")
    profile = profile_for(student)
    if interest.strip():
        profile["interest"] = interest.strip()
    interest = profile["interest"]
    picks, select_info = select_questions(competency_ids, student, educator_prompt, per_competency)
    wraps = rewrap_questions(picks, interest)
    prep = {
        "id": uuid.uuid4().hex[:8],
        "student": student,
        "interest": interest,
        "competencies": competency_ids,
        "educator_prompt": educator_prompt,
        "per_competency": per_competency,
        "created_at": time.time(),
        "status": "draft",
        "select_info": select_info,
        "llm": llm.mode(),
        "questions": [],
    }
    for q in picks:
        w = wraps[q["id"]]
        prep["questions"].append(
            {
                "id": q["id"],
                "competency": q["competency"],
                "difficulty": q["difficulty"],
                "original": q["prompt"],
                "text": w["text"],
                "missing_numbers": w["missing"],
                "flagged": w["flagged"],
                "note": w.get("note"),
                "status": "ok",  # ok | edited | rejected
            }
        )
    PREPS[prep["id"]] = prep
    return prep


def edit_prep_question(prep, qid, text):
    for pq in prep["questions"]:
        if pq["id"] == qid:
            pq["text"] = text.strip()
            pq["missing_numbers"], pq["note"] = check_rewrap(BY_ID[qid], pq["text"])
            pq["flagged"] = bool(pq["missing_numbers"] or pq["note"])
            pq["status"] = "edited"
            return pq
    raise KeyError(qid)


def reject_prep_question(prep, qid, rejected=True):
    for pq in prep["questions"]:
        if pq["id"] == qid:
            pq["status"] = "rejected" if rejected else "ok"
            return pq
    raise KeyError(qid)


def regenerate_prep_question(prep, qid):
    for pq in prep["questions"]:
        if pq["id"] == qid:
            w = rewrap_questions([BY_ID[qid]], prep["interest"])[qid]
            pq.update(
                {
                    "text": w["text"],
                    "missing_numbers": w["missing"],
                    "flagged": w["flagged"],
                    "note": w.get("note"),
                    "status": "ok",
                }
            )
            return pq
    raise KeyError(qid)


def approve_prep(prep):
    live = [pq for pq in prep["questions"] if pq["status"] != "rejected"]
    if not live:
        raise ValueError("every question was rejected")
    prep["status"] = "approved"
    return start_session(prep["student"], prep["competencies"], live, prep_id=prep["id"])


# ---------------------------------------------------------------- session


def start_session(student, competency_ids, prep_questions, prep_id=None):
    sid = uuid.uuid4().hex[:8]
    session = {
        "id": sid,
        "student": student,
        "competencies": competency_ids,
        "prep_id": prep_id,
        "started_at": time.time(),
        "status": "active",
        "order": [],  # question ids in the order answered
        "questions": {},
    }
    for pq in prep_questions:
        bank_q = BY_ID[pq["id"]]
        session["questions"][pq["id"]] = {
            "id": pq["id"],
            "competency": pq["competency"],
            "difficulty": pq["difficulty"],
            "prompt": pq["text"],
            "original": pq["original"],
            "answer": bank_q["answer"],
            "opened_at": None,
            "answered_at": None,
            "seconds": None,
            "given": None,
            "correct": None,
            "help_turns": 0,
            "transcript": [],
        }
    SESSIONS[sid] = session
    return session


def public_session(session):
    """Session as the student frontend should see it (no answers, no originals)."""
    qs = [{k: v for k, v in q.items() if k not in ("answer", "original")} for q in session["questions"].values()]
    return {**session, "questions": qs}


def open_question(session, qid):
    q = session["questions"][qid]
    if q["opened_at"] is None:
        q["opened_at"] = time.time()
    return q


def answer_question(session, qid, given):
    q = session["questions"][qid]
    if q["answered_at"] is not None:
        return {"already_answered": True, "correct": q["correct"]}
    open_question(session, qid)
    q["given"] = given
    q["correct"] = is_correct(given, q["answer"])
    q["answered_at"] = time.time()
    q["seconds"] = round(q["answered_at"] - q["opened_at"], 1)
    session["order"].append(qid)
    return {"correct": q["correct"], "seconds": q["seconds"]}


def ask_tutor(session, qid, message):
    q = session["questions"][qid]
    if q["help_turns"] >= HELP_CAP:
        return {"reply": None, "capped": True, "help_turns": q["help_turns"]}
    open_question(session, qid)
    q["transcript"].append({"role": "student", "text": message, "t": time.time()})
    messages = prompt_library.messages("tutor", question=q["prompt"])
    for turn in q["transcript"]:
        messages.append({"role": "user" if turn["role"] == "student" else "assistant", "content": turn["text"]})
    reply = llm.chat(messages, prompt_id="tutor", mock_reply=_mock_hint(q))  # MOCK: canned hint per competency
    q["transcript"].append({"role": "tutor", "text": reply, "t": time.time()})
    q["help_turns"] += 1
    return {"reply": reply, "capped": q["help_turns"] >= HELP_CAP, "help_turns": q["help_turns"]}


def _mock_hint(q):
    """MOCK: offline stand-in for the tutor call."""
    hints = {
        "integers": "Picture a number line. Which direction does each step move you?",
        "fractions": "What number divides evenly into both the top and the bottom?",
        "ratios": "Try writing both quantities as a fraction first, then simplify.",
        "percentages": "Remember that a percent is just a fraction out of 100.",
        "linear_equations": "What could you do to both sides to get x by itself?",
        "proportions": "Set the two ratios equal and cross-multiply.",
    }
    return hints.get(q["competency"], "What do you already know about this problem?")


# ---------------------------------------------------------------- summary


def _competency_stats(session):
    stats = {}
    for cid in session["competencies"]:
        qs = [q for q in session["questions"].values() if q["competency"] == cid]
        answered = [q for q in qs if q["answered_at"] is not None]
        correct = [q for q in answered if q["correct"]]
        help_turns = sum(q["help_turns"] for q in qs)
        secs = [q["seconds"] for q in answered if q["seconds"] is not None]
        accuracy = len(correct) / len(answered) if answered else 0.0
        help_rate = min(help_turns / (len(qs) * HELP_CAP), 1.0) if qs else 0.0
        score = round(0.7 * accuracy + 0.3 * (1 - help_rate), 2) if answered else 0.0
        if not answered:
            status = "not_attempted"
        elif score >= MASTERED:
            status = "mastered"
        elif score >= DEVELOPING:
            status = "developing"
        else:
            status = "struggling"
        stats[cid] = {
            "name": COMPETENCIES[cid]["name"],
            "asked": len(qs),
            "answered": len(answered),
            "correct": len(correct),
            "accuracy": round(accuracy, 2),
            "avg_seconds": round(sum(secs) / len(secs), 1) if secs else None,
            "help_turns": help_turns,
            "score": score,
            "status": status,
        }
    return stats


def _find_blockers(stats, profile):
    """A weak competency that a weak dependent relies on is a blocker."""

    def status_of(cid):
        if cid in stats:
            return stats[cid]["status"]
        return profile["competencies"].get(cid, {}).get("status", "unknown")

    blockers = []
    for cid, info in COMPETENCIES.items():
        for prereq in info["prerequisites"]:
            if status_of(prereq) in ("struggling", "developing") and status_of(cid) in ("struggling", "developing"):
                blockers.append(
                    {
                        "blocker": prereq,
                        "blocks": cid,
                        "from_profile": prereq not in stats and cid not in stats,
                        "reason": f"{COMPETENCIES[prereq]['name']} is {status_of(prereq)} "
                        f"and {info['name']} depends on it.",
                    }
                )
    return blockers


def _partial_graph(stats, profile):
    nodes, edges = {}, []
    for cid, s in stats.items():
        nodes[cid] = {
            "id": cid,
            "name": s["name"],
            "status": s["status"],
            "score": s["score"],
            "source": "this_session",
        }
    for cid in list(nodes):
        for prereq in COMPETENCIES[cid]["prerequisites"]:
            if prereq not in nodes:
                known = profile["competencies"].get(prereq)
                nodes[prereq] = {
                    "id": prereq,
                    "name": COMPETENCIES[prereq]["name"],
                    "status": known["status"] if known else "unknown",
                    "score": known["score"] if known else None,
                    "source": "profile",
                }
            edges.append({"from": prereq, "to": cid})
    return {"nodes": list(nodes.values()), "edges": edges}


def finish_session(session):
    profile = profile_for(session["student"])
    stats = _competency_stats(session)
    blockers = _find_blockers(stats, profile)
    graph = _partial_graph(stats, profile)
    ranking = sorted(stats, key=lambda c: stats[c]["score"], reverse=True)
    log = [
        {
            "question_id": qid,
            "competency": session["questions"][qid]["competency"],
            "difficulty": session["questions"][qid]["difficulty"],
            "correct": session["questions"][qid]["correct"],
            "seconds": session["questions"][qid]["seconds"],
            "help_turns": session["questions"][qid]["help_turns"],
        }
        for qid in session["order"]
    ]
    payload = {"student": session["student"], "competencies": stats, "order": log, "blockers": blockers}
    summary = llm.chat(
        prompt_library.messages("summarize_session", payload=json.dumps(payload, indent=1)),
        prompt_id="summarize_session",
        mock_reply=_mock_summary(session, stats, blockers),
    )  # MOCK: templated summary
    session["status"] = "finished"
    session["review"] = {
        "session_id": session["id"],
        "student": session["student"],
        "summary": summary,
        "ranking": ranking,
        "stats": stats,
        "blockers": blockers,
        "graph": graph,
        "log": log,
        "approved": False,
        "llm": llm.mode(),
    }
    return session["review"]


def _mock_summary(session, stats, blockers):
    """MOCK: offline stand-in for the summary call, built from the computed stats."""
    parts = []
    order = [session["questions"][q]["competency"] for q in session["order"]]
    if order:
        parts.append(
            f"{session['student']} answered {len(order)} questions, "
            f"starting with {COMPETENCIES[order[0]]['name'].lower()}."
        )
    for cid, s in stats.items():
        parts.append(
            f"{s['name']}: {s['correct']}/{s['answered']} correct, "
            f"{s['help_turns']} tutor turns ({s['status'].replace('_', ' ')})."
        )
    for b in blockers:
        parts.append(f"Possible blocker: {b['reason']}")
    return " ".join(parts) or "No questions were answered."


# ---------------------------------------------------------------- approval


def approve_review(session, overrides=None, note=None):
    review = session["review"]
    profile = profile_for(session["student"])
    overrides = overrides or {}
    for node in review["graph"]["nodes"]:
        if node["source"] != "this_session":
            continue
        cid = node["id"]
        status = overrides.get(cid, node["status"])
        if status == "not_attempted":
            continue
        entry = profile["competencies"].setdefault(cid, {"status": status, "score": node["score"], "history": []})
        entry["history"].append(
            {"session": session["id"], "status": status, "score": node["score"], "overridden": cid in overrides}
        )
        entry["status"], entry["score"] = status, node["score"]
        node["status"] = status
    if note:
        profile["notes"].append({"session": session["id"], "note": note})
    profile["sessions"] += 1
    review["approved"] = True
    review["overrides"] = overrides
    return profile


def profile_graph(student):
    profile = profile_for(student)
    nodes = [
        {"id": cid, "name": info["name"], **profile["competencies"].get(cid, {"status": "unknown", "score": None})}
        for cid, info in COMPETENCIES.items()
    ]
    edges = [{"from": p, "to": cid} for cid, info in COMPETENCIES.items() for p in info["prerequisites"]]
    return {
        "nodes": nodes,
        "edges": edges,
        "notes": profile["notes"],
        "sessions": profile["sessions"],
        "interest": profile["interest"],
    }
